# Caps Lock + A sends the tmux prefix (Ctrl+Space). Karabiner turns held Caps Lock into Cmd+Ctrl.
keybind = cmd+ctrl+a=text:\x00
# No padding: text and the tmux bar run to the window edges (cmux's tab bar is already at the top)
window-padding-x = 0
window-padding-y = 0
# Lines 2px shorter, so a whole number of them fills a full-height window on the built-in display
# and the tmux bar ends right at the bottom edge. Other screen sizes may leave a small gap.
adjust-cell-height = -2
