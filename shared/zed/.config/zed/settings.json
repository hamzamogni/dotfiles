// Zed set up to feel like the LazyVim config in shared/nvim. Leader keys live in keymap.json.
{
  "gutter": {
    "line_numbers": true
  },
  "show_wrap_guides": true,
  "tab_bar": {
    "show": false,
    "show_pinned_tabs_in_separate_row": false
  },
  "preview_tabs": {
    "enabled": true
  },
  "tabs": {
    "show_diagnostics": "off",
    "git_status": false
  },
  "diff_view_style": "unified",
  "vim_mode": true,
  "vim": {
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true
  },
  "relative_line_numbers": "enabled",
  "which_key": {
    "enabled": true,
    "delay_ms": 300
  },

  // Catppuccin Mocha in dark mode, Latte in light mode, like Neovim
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },
  "auto_install_extensions": {
    "catppuccin": true,
    "catppuccin-icons": true
  },

  // Same font as Ghostty
  "buffer_font_family": "Maple Mono NF",
  "buffer_font_size": 14,
  "buffer_font_features": {
    "calt": false
  },

  "vertical_scroll_margin": 4,
  "format_on_save": "on"
}
