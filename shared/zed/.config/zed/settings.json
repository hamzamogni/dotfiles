// Zed set up to feel like the LazyVim config in shared/nvim. Leader keys live in keymap.json.
{
  "git_panel": {
    "tree_view": true
  },
  "agent": {
    "sandbox_permissions": {
      "network_hosts": [
        "raw.githubusercontent.com"
      ]
    },
    "tool_permissions": {
      "tools": {
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https?://raw\\.githubusercontent\\.com"
            }
          ]
        },
        "skill": {
          "default": "allow"
        }
      }
    },
    "default_profile": "ask",
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-6.1-sol",
      "enable_thinking": true,
      "effort": "low"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "gutter": {
    "line_numbers": true
  },
  "show_wrap_guides": true,
  "tab_bar": {
    "show": false,
    "show_pinned_tabs_in_separate_row": false
  },
  "preview_tabs": {
    "enabled": true
  },
  "tabs": {
    "show_diagnostics": "off",
    "git_status": false
  },
  "diff_view_style": "unified",
  "vim_mode": true,
  "vim": {
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true
  },
  "relative_line_numbers": "enabled",
  "which_key": {
    "enabled": true,
    "delay_ms": 300
  },

  // T3 Dark in dark mode, T3 Light in light mode, like Ghostty (themes/t3.json).
  // To switch, press space u shift-c (or cmd-k cmd-t) and pick a theme. Zed saves the pick here, in
  // the slot for the current light/dark mode. Other choices: "Catppuccin Mocha" / "Catppuccin Latte",
  // "One Dark" / "One Light", "Ayu Dark" / "Ayu Light", "Gruvbox Dark" / "Gruvbox Light".
  "theme": {
    "mode": "system",
    "light": "T3 Light",
    "dark": "T3 Dark"
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },
  "auto_install_extensions": {
    "catppuccin": true,
    "catppuccin-icons": true
  },

  // Same font as Ghostty
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 14,
  "buffer_font_features": {
    "calt": false
  },

  "vertical_scroll_margin": 4,
  "format_on_save": "on"
}
