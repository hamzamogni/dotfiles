// Run by <leader>gg in keymap.json, like LazyVim's lazygit float
[
  {
    "label": "lazygit",
    "command": "lazygit",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal_target": "center",
    "hide": "always",
    "use_new_terminal": true,
    "allow_concurrent_runs": true,
    "show_summary": false,
    "show_command": false
  }
]
