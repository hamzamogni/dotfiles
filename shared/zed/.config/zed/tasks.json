[
  {
    "label": "lazygit",
    "command": "lazygit",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal_target": "center",
    "hide": "always",
    "use_new_terminal": true,
    "allow_concurrent_runs": true,
    "show_summary": false,
    "show_command": false,
  },
  {
    "label": "difft: branch vs main",
    "command": "GIT_EXTERNAL_DIFF=difft git diff origin/main...HEAD",
    "reveal_target": "center",
    "use_new_terminal": true,
  },
  {
    "label": "difft: current file vs main",
    "command": "GIT_EXTERNAL_DIFF=difft git diff origin/main...HEAD -- \"$ZED_RELATIVE_FILE\"",
    "reveal_target": "center",
    "use_new_terminal": true,
  },
]
